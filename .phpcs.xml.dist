<?xml version="1.0"?>
<ruleset name="trident-cache-woocommerce">
	<description>WordPress Coding Standards, adapted to a PSR-4 plugin (as WooCommerce's own src/ is).</description>
	<file>trident-cache-woocommerce.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 file and class names (Plugin.php, not class-plugin.php). -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Constructor property promotion, readonly, typed properties. -->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed"/>
	</rule>
	<rule ref="WordPress-Docs">
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>
	<!-- Properties of qoliber/trident-php objects follow the library's PSR-12 names. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="cacheControl"/>
				<element value="apiUrl"/>
				<element value="bytesFreed"/>
				<element value="apiToken"/>
				<element value="contentLength"/>
				<element value="contentType"/>
				<element value="entriesRemoved"/>
				<element value="estimatedBytes"/>
				<element value="graceRemaining"/>
				<element value="hasMore"/>
				<element value="lastResolved"/>
				<element value="maxMemory"/>
				<element value="memoryUsed"/>
				<element value="purgedCount"/>
				<element value="resolvedIps"/>
				<element value="rssBytes"/>
				<element value="statusCode"/>
				<element value="storageKey"/>
				<element value="totalBytes"/>
				<element value="totalErrors"/>
				<element value="totalRequests"/>
				<element value="ttlRemaining"/>
				<element value="windowSecs"/>
				<element value="wouldPurge"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="trident-cache-woocommerce"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="trident"/>
				<element value="Qoliber\TridentWoo"/>
			</property>
		</properties>
	</rule>
</ruleset>
